# Normalise line endings. Scripts must stay LF or they break on Linux/macOS.
* text=auto eol=lf

# Executables / scripts — always LF
*.mjs   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Never touch these
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp3   binary
*.wav   binary
*.mp4   binary
*.mov   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.exe   binary

# Keep the installer scripts executable when checked out on Unix
install.sh text eol=lf
scripts/*.mjs text eol=lf