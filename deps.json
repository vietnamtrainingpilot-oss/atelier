{
  "$schema": "./deps.schema.json",
  "name": "atelier",
  "version": "1.0.0",
  "description": "Domain routers that dispatch agent skills to the right specialist.",
  "skillRoots": {
    "opencode": "~/.config/opencode/skills",
    "claude": "~/.claude/skills",
    "agents": "~/.agents/skills",
    "cursor": "~/.cursor/skills",
    "codex": "~/.codex/skills",
    "windsurf": "~/.codeium/windsurf/skills",
    "gemini": "~/.gemini/skills"
  },
  "preferenceOrder": [
    "agents",
    "opencode",
    "claude",
    "cursor",
    "codex",
    "windsurf",
    "gemini"
  ],
  "bundling": {
    "dir": "bundled/skills",
    "exclude": [
      "img2threejs",
      "impeccable"
    ],
    "note": "Private-origin skills only (36). Public skills are cloned from their upstream GitHub at install time. Resolution order: already-installed -> bundled (private) -> public GitHub. Offline installs therefore cover private skills only.",
    "excludeReason": {
      "img2threejs": "39.9MB of reference imagery for 3D model generation. Niche; fetched on demand.",
      "impeccable": "16MB audit corpus. Optional quality gate; fetched on demand."
    },
    "count": 36,
    "strategy": "private-only"
  },
  "postInstall": [
    {
      "skill": "claude-security",
      "why": "Its SKILL.md references ${CLAUDE_PLUGIN_ROOT}, which is unset outside Claude Code.",
      "action": "rewrite CLAUDE_PLUGIN_ROOT in .md files to the installed absolute path"
    }
  ],
  "repo": "https://github.com/atelier-skills/atelier",
